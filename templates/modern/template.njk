<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ contact.name }} - CV</title>
  <style>
    {{ css | safe }}
  </style>
</head>
<body class="modern">
  <div class="cv-page">
    {# Import shared macros #}
    {% from "../_shared/macros/entry.njk" import experienceEntry, educationEntry, projectEntry, certificationEntry %}

    {# Contact in body, not header - ATS-02 #}
    <header class="contact">
      <h1>{{ contact.name }}</h1>
      <div class="contact-info">
        {% if contact.email %}<span class="contact-item">{{ contact.email }}</span>{% endif %}
        {% if contact.phone %}<span class="contact-item">{{ contact.phone }}</span>{% endif %}
        {% if contact.location %}<span class="contact-item">{{ contact.location }}</span>{% endif %}
      </div>
      {% if contact.links and contact.links | length > 0 %}
      <div class="contact-links">
        {% for link in contact.links %}
        <a href="{{ link.url }}" class="contact-link">{{ link.label or link.type }}</a>
        {% endfor %}
      </div>
      {% endif %}
    </header>

    <main>
      {# Summary section #}
      {% if summary %}
      <section class="section summary">
        <h2>{{ 'summary' | sectionHeader(locale) }}</h2>
        <p class="summary-text">{{ summary | md | safe }}</p>
      </section>
      {% endif %}

      {# Work Experience section #}
      {% if experience and experience | length > 0 %}
      <section class="section experience">
        <h2>{{ 'experience' | sectionHeader(locale) }}</h2>
        {% for job in experience %}
        {{ experienceEntry(job, locale) }}
        {% endfor %}
      </section>
      {% endif %}

      {# Education section #}
      {% if education and education | length > 0 %}
      <section class="section education">
        <h2>{{ 'education' | sectionHeader(locale) }}</h2>
        {% for edu in education %}
        {{ educationEntry(edu, locale) }}
        {% endfor %}
      </section>
      {% endif %}

      {# Projects section #}
      {% if projects and projects | length > 0 %}
      <section class="section projects">
        <h2>{{ 'projects' | sectionHeader(locale) }}</h2>
        {% for project in projects %}
        {{ projectEntry(project, locale) }}
        {% endfor %}
      </section>
      {% endif %}

      {# Skills section #}
      {% if skills and skills | length > 0 %}
      <section class="section skills">
        <h2>{{ 'skills' | sectionHeader(locale) }}</h2>
        {% for category in skills %}
        <div class="skill-category">
          <h3 class="skill-category-name">{{ category.name }}</h3>
          <div class="skill-list">
            {% for skill in category.skills %}
            <span class="skill">{{ skill.name }}{% if skill.level %} ({{ skill.level }}){% endif %}</span>
            {% endfor %}
          </div>
        </div>
        {% endfor %}
      </section>
      {% endif %}

      {# Certifications section #}
      {% if certifications and certifications | length > 0 %}
      <section class="section certifications">
        <h2>{{ 'certifications' | sectionHeader(locale) }}</h2>
        {% for cert in certifications %}
        {{ certificationEntry(cert, locale) }}
        {% endfor %}
      </section>
      {% endif %}
    </main>
  </div>

  {# Theme toggle button - hidden in print #}
  <button class="theme-toggle" type="button" aria-label="Toggle color theme">
    <span class="theme-icon" data-icon="system">&#x2699;</span>
    <span class="theme-icon" data-icon="light">&#x2600;</span>
    <span class="theme-icon" data-icon="dark">&#x263D;</span>
  </button>

  <script>
    (function() {
      const toggle = document.querySelector('.theme-toggle');
      const html = document.documentElement;
      const STORAGE_KEY = 'cv-theme';
      const THEMES = ['system', 'light', 'dark'];

      function getStoredTheme() {
        try {
          return localStorage.getItem(STORAGE_KEY);
        } catch {
          return null;
        }
      }

      function setStoredTheme(theme) {
        try {
          if (theme === 'system') {
            localStorage.removeItem(STORAGE_KEY);
          } else {
            localStorage.setItem(STORAGE_KEY, theme);
          }
        } catch {}
      }

      function applyTheme(theme) {
        html.setAttribute('data-theme', theme);
        updateAriaLabel(theme);
      }

      function updateAriaLabel(theme) {
        const labels = {
          system: 'Current: system preference. Click to switch to light mode.',
          light: 'Current: light mode. Click to switch to dark mode.',
          dark: 'Current: dark mode. Click to switch to system preference.'
        };
        toggle.setAttribute('aria-label', labels[theme] || labels.system);
      }

      function cycleTheme() {
        const current = html.getAttribute('data-theme') || 'system';
        const currentIndex = THEMES.indexOf(current);
        const nextIndex = (currentIndex + 1) % THEMES.length;
        const nextTheme = THEMES[nextIndex];
        applyTheme(nextTheme);
        setStoredTheme(nextTheme);
      }

      // Initialize on load
      const stored = getStoredTheme();
      const initial = stored && THEMES.includes(stored) ? stored : 'system';
      applyTheme(initial);

      toggle.addEventListener('click', cycleTheme);
    })();
  </script>
</body>
</html>
